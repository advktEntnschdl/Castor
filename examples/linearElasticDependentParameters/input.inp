*job, name=job, domain=3d

*solver, solver=NISTParallel, name=theSolver

*include, input=additionalInput/geometry.inc

*material, name=LinearElastic, id=mat
** [0] E
_E_,
** [1] nu
_Nu_

*section, name=section1, material=mat, type=solid
all

*step, solver=theSolver, maxInc=1, minInc=1, maxNumInc=1, maxIter=25, stepLength=1
dirichlet, name=001, nSet=gen_bottom, field=displacement, 1=0, 2=0.
dirichlet, name=002, nSet=gen_left,   field=displacement, 1=0.
dirichlet, name=003, nSet=gen_back,   field=displacement, 3=0.
dirichlet, name=004, nSet=gen_top,    field=displacement, 1=0, 2=10.

*fieldOutput,
create=perNode, name=displacement, elSet=all, field=displacement,   result=U
create=perNode, name=nodeforces,   elSet=all, field=displacement,   result=P

create=perNode, name=U,   nSet=gen_top,    field=displacement, result=U, f(x)='mean(x[:,1])', saveHistory=true, export=U
create=perNode, name=RF2, nSet=gen_bottom, field=displacement, result=P, f(x)='sum(x[:,1])',  saveHistory=true, export=RF

create=perElement, name=stress, elSet=all, result=stress, quadraturePoint=0:4, f(x)='np.mean(x,axis=1)'
create=perElement, name=strain, elSet=all, result=strain, quadraturePoint=0:4, f(x)='np.mean(x,axis=1)'

*output, type=ensight, name=esExport
create=perNode,    fieldOutput=displacement 
create=perNode,    fieldOutput=nodeforces
create=perElement, fieldOutput=stress
create=perElement, fieldOutput=strain
configuration,     overwrite=yes


*material, name=MYMAT003,       id=mat
**  lambda,   kappa,    nu,       MCSL      e_0,      pc_0
    .14,      .03,      .3,       1.2,      1.1,      200.,
**  GcToG     lb        lt        polarR
    _GC2G_,   5.,       10.,      1.4999999,
**  a1        a2        a3        a4        lJ2       l
    0.5,      0.0,      0.5,      0.0,      5.0,      10.

*job, name=triax, domain=3d, solver=NISTParallel

*modelGenerator, generator=boxGen, name=gen
elType  =CC3D8

*section, name=section1, material=mat, type=solid
all

*fieldOutput,
name=displacement,  elSet=all,           field=displacement,   result=U
name=nodeforces,    elSet=all,           field=displacement,   result=P
name=rotations,     elSet=all,           field=micro rotation, result=U
name=nonLocal,      elSet=all,           field=nonlocal damage,result=U

name=U,             nSet=gen_top,         field=displacement, result=U, f(x)='mean(x[:,1])',  saveHistory=true, export=U
name=RF1,           nSet=gen_bottom,      field=displacement, result=P, f(x)='sum(x[:,0])',   saveHistory=true
name=RF2,           nSet=gen_bottom,      field=displacement, result=P, f(x)='sum(x[:,1])',   saveHistory=true, export=RF

name=stress,        elSet=all,  result=stress,  quadraturePoint=0:3,  f(x)='np.mean(x,axis=1)'
name=strain,        elSet=all,  result=strain,  quadraturePoint=0:3,  f(x)='np.mean(x,axis=1)'

name=p,             elSet=all,  result=p,       quadraturePoint=0:3,  f(x)='max( x[:,:], axis=1)',
name=q,             elSet=all,  result=q,       quadraturePoint=0:3,  f(x)='max( x[:,:], axis=1)',
name=e,             elSet=all,  result=e,       quadraturePoint=0:3,  f(x)='mean( x[:,:], axis=1)',
name=pc,            elSet=all,  result=pc,      quadraturePoint=0:3,  f(x)='max( x[:,:], axis=1)',
name=f,             elSet=all,  result=f,       quadraturePoint=0:3,  f(x)='max( x[:,:], axis=1)',

** *output, type=meshplot, jobName=PST, name=RFPlot
** figure=1, axSpec=111, c=k, ls=solid, create=xyData, x=time, y=RF2

*output, type=ensight, jobName=triax, name=esExport
create=perNode,     fieldOutput=displacement 
create=perNode,     fieldOutput=nodeforces
create=perNode,     fieldOutput=rotations
create=perNode,     fieldOutput=nonLocal
create=perElement,  fieldOutput=stress
create=perElement,  fieldOutput=strain
create=perElement,  fieldOutput=p
create=perElement,  fieldOutput=q
create=perElement,  fieldOutput=e
create=perElement,  fieldOutput=pc
create=perElement,  fieldOutput=f
configuration, overwrite=yes


*step, jobName=triax, maxInc=5e-1, minInc=1e-3, maxNumInc=1000, maxIter=25, stepLength=1
initializematerial, name=init,    elSet=all 
geostatic,          name=p,       elSet=all, p1=-_PINI_, h1=1., p2=-_PINI_, h2=0., xLateral=1.0, zLateral=1.0

dirichlet,          name=001, nSet=gen_left,      field=displacement,   1=0.
dirichlet,          name=002, nSet=gen_bottom,    field=displacement,   2=0.
dirichlet,          name=003, nSet=gen_back,      field=displacement,   3=0.

distributedload,    name=001, surface=gen_right,  magnitude=_PINI_, f(t)=1, type=pressure
distributedload,    name=002, surface=gen_top,    magnitude=_PINI_, f(t)=1, type=pressure
distributedload,    name=003, surface=gen_front,  magnitude=_PINI_, f(t)=1, type=pressure

*step, jobName=triax, maxInc=5e-02, minInc=1e-06, maxNumInc=1000000, maxIter=25, stepLength=1
dirichlet,          name=004, nSet=gen_top,       field=displacement,   2=-5e-2


*material, name=LinearElastic,       id=mat
**  E,      nu
    _E_,    _Nu_

*job, name=job, domain=3d, solver=NISTParallel

*modelGenerator, generator=boxGen, name=gen
lX      = 50
lY      = 100
lZ      = 10
nX      = 5
nY      = 10
nZ      = 1
elType  = C3D20R

*section, name=section1, material=mat, type=solid
all

*fieldOutput,
name=displacement,  elSet=all,           field=displacement,   result=U
name=nodeforces,    elSet=all,           field=displacement,   result=P

name=U,             nSet=gen_top,         field=displacement, result=U, f(x)='mean(x[:,1])',  saveHistory=true, export=U
name=RF2,           nSet=gen_bottom,      field=displacement, result=P, f(x)='sum(x[:,1])',   saveHistory=true, export=RF

name=stress,        elSet=all,  result=stress,  quadraturePoint=0:3,  f(x)='np.mean(x,axis=1)'
name=strain,        elSet=all,  result=strain,  quadraturePoint=0:3,  f(x)='np.mean(x,axis=1)'

*output, type=ensight, jobName=job, name=esExport
create=perNode,     fieldOutput=displacement 
create=perNode,     fieldOutput=nodeforces
create=perElement,  fieldOutput=stress
create=perElement,  fieldOutput=strain
configuration,      overwrite=yes

*step, jobName=job, maxInc=1, minInc=1, maxNumInc=1, maxIter=25, stepLength=1
dirichlet,  name=001, nSet=gen_bottom,  field=displacement, 1=0, 2=0.
dirichlet,  name=002, nSet=gen_left,    field=displacement, 1=0.
dirichlet,  name=003, nSet=gen_back,    field=displacement, 3=0.
dirichlet,  name=004, nSet=gen_top,     field=displacement, 1=0, 2=10.

